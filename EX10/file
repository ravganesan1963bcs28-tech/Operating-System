
#include <stdio.h>
#include <string.h>

#define MAX_BLOCKS 50
#define MAX_FILES 20
#define MAX_NAME 20

int disk[MAX_BLOCKS];          // 0 = free, 1 = allocated
char fileNames[MAX_FILES][MAX_NAME];
int fileStart[MAX_FILES];      // Starting block of each file
int fileLength[MAX_FILES];     // Number of blocks for each file
int fileCount = 0;
int totalBlocks;

// Function to initialize disk
void initDisk()
{
    int i;
    for (i = 0; i < totalBlocks; i++)
    {
        disk[i] = 0;
    }
}

// Function to display disk status
void displayDisk()
{
    int i;
    printf("\nDISK BLOCK STATUS\n");
    printf("Block No\tStatus\t\tFile\n");
    printf("--------\t------\t\t----\n");
    for (i = 0; i < totalBlocks; i++)
    {
        if (disk[i] == 0)
            printf("%d\t\tFree\t\t-\n", i);
        else
        {
            int j;
            int found = 0;
            for (j = 0; j < fileCount; j++)
            {
                if (i >= fileStart[j] && i < fileStart[j] + fileLength[j])
                {
                    printf("%d\t\tAllocated\t%s\n", i, fileNames[j]);
                    found = 1;
                    break;
                }
            }
            if (!found)
                printf("%d\t\tAllocated\t-\n", i);
        }
    }
}

// Function to display file table (directory)
void displayFileTable()
{
    int i;
    if (fileCount == 0)
    {
        printf("\nNo files allocated.\n");
        return;
    }

    printf("\nFILE ALLOCATION TABLE (DIRECTORY)\n");
    printf("File Name\tStart Block\tLength\t\tEnd Block\n");
    printf("---------\t-----------\t------\t\t---------\n");
    for (i = 0; i < fileCount; i++)
    {
        printf("%s\t\t%d\t\t%d\t\t%d\n", fileNames[i], fileStart[i],
               fileLength[i], fileStart[i] + fileLength[i] - 1);
    }
}

// Function to create/allocate a file
void createFile()
{
    char name[MAX_NAME];
    int start, length;
    int i, j;

    if (fileCount >= MAX_FILES)
    {
        printf("\nMaximum file limit reached!\n");
        return;
    }

    printf("\nEnter file name: ");
    scanf("%s", name);

    // Check if file name already exists
    for (i = 0; i < fileCount; i++)
    {
        if (strcmp(fileNames[i], name) == 0)
        {
            printf("File '%s' already exists!\n", name);
            return;
        }
    }

    printf("Enter starting block: ");
    scanf("%d", &start);

    printf("Enter number of blocks needed: ");
    scanf("%d", &length);

    // Validate starting block
    if (start < 0 || start >= totalBlocks)
    {
        printf("Invalid starting block! Must be between 0 and %d\n", totalBlocks - 1);
        return;
    }

    // Check if file fits within disk
    if (start + length > totalBlocks)
    {
        printf("Error: File exceeds disk size!\n");
        printf("Starting from block %d, only %d blocks available.\n",
               start, totalBlocks - start);
        return;
    }

    // Check if all required blocks are free (CONTIGUOUS CHECK)
    for (i = start; i < start + length; i++)
    {
        if (disk[i] == 1)
        {
            printf("Error: Block %d is already allocated!\n", i);
            printf("Contiguous allocation failed. Blocks %d to %d are not all free.\n",
                   start, start + length - 1);
            return;
        }
    }

    // Allocate the blocks
    for (i = start; i < start + length; i++)
    {
        disk[i] = 1;
    }

    // Store file details
    strcpy(fileNames[fileCount], name);
    fileStart[fileCount] = start;
    fileLength[fileCount] = length;
    fileCount++;

    printf("\nFile '%s' allocated successfully!\n", name);
    printf("Blocks allocated: %d to %d (%d blocks)\n",
           start, start + length - 1, length);
}

// Function to delete a file
void deleteFile()
{
    char name[MAX_NAME];
    int i, j;
    int found = -1;

    if (fileCount == 0)
    {
        printf("\nNo files to delete.\n");
        return;
    }

    printf("\nExisting files: ");
    for (i = 0; i < fileCount; i++)
    {
        printf("%s", fileNames[i]);
        if (i < fileCount - 1)
            printf(", ");
    }
    printf("\n");

    printf("Enter file name to delete: ");
    scanf("%s", name);

    // Find the file
    for (i = 0; i < fileCount; i++)
    {
        if (strcmp(fileNames[i], name) == 0)
        {
            found = i;
            break;
        }
    }

    if (found == -1)
    {
        printf("File '%s' not found!\n", name);
        return;
    }

    // Free the disk blocks
    for (i = fileStart[found]; i < fileStart[found] + fileLength[found]; i++)
    {
        disk[i] = 0;
    }

    printf("\nFile '%s' deleted successfully!\n", name);
    printf("Blocks %d to %d (%d blocks) freed.\n",
           fileStart[found], fileStart[found] + fileLength[found] - 1,
           fileLength[found]);

    // Shift remaining files in the table
    for (i = found; i < fileCount - 1; i++)
    {
        strcpy(fileNames[i], fileNames[i + 1]);
        fileStart[i] = fileStart[i + 1];
        fileLength[i] = fileLength[i + 1];
    }
    fileCount--;
}

// Function to access a specific block of a file
void accessBlock()
{
    char name[MAX_NAME];
    int blockNum;
    int i, found = -1;

    if (fileCount == 0)
    {
        printf("\nNo files available.\n");
        return;
    }

    printf("\nEnter file name: ");
    scanf("%s", name);

    for (i = 0; i < fileCount; i++)
    {
        if (strcmp(fileNames[i], name) == 0)
        {
            found = i;
            break;
        }
    }

    if (found == -1)
    {
        printf("File '%s' not found!\n", name);
        return;
    }

    printf("Enter block number to access (0 to %d): ", fileLength[found] - 1);
    scanf("%d", &blockNum);

    if (blockNum < 0 || blockNum >= fileLength[found])
    {
        printf("Invalid block number! File '%s' has %d blocks (0 to %d).\n",
               name, fileLength[found], fileLength[found] - 1);
        return;
    }

    int diskBlock = fileStart[found] + blockNum;

    printf("\nBLOCK ACCESS DETAILS\n");
    printf("File Name      : %s\n", name);
    printf("Logical Block  : %d\n", blockNum);
    printf("Start Block    : %d\n", fileStart[found]);
    printf("Disk Block     : %d + %d = %d\n", fileStart[found], blockNum, diskBlock);
}

// Function to display free and allocated space
void displayDiskInfo()
{
    int freeBlocks = 0, allocatedBlocks = 0;
    int i;

    for (i = 0; i < totalBlocks; i++)
    {
        if (disk[i] == 0)
            freeBlocks++;
        else
            allocatedBlocks++;
    }

    printf("\nDISK INFORMATION\n");
    printf("Total Blocks    : %d\n", totalBlocks);
    printf("Allocated Blocks: %d\n", allocatedBlocks);
    printf("Free Blocks     : %d\n", freeBlocks);
    printf("Total Files     : %d\n", fileCount);
}

int main()
{
    int option;
    char choice;

    printf("Enter total number of disk blocks: ");
    scanf("%d", &totalBlocks);

    if (totalBlocks <= 0 || totalBlocks > MAX_BLOCKS)
    {
        printf("Invalid! Must be between 1 and %d\n", MAX_BLOCKS);
        return 1;
    }

    initDisk();

    do
    {
        printf("\nCONTIGUOUS FILE ALLOCATION\n");
        printf("1. Create File\n");
        printf("2. Display File Table\n");
        printf("3. Display Disk Status\n");
        printf("4. Delete File\n");
        printf("5. Access Block\n");
        printf("6. Disk Information\n");
        printf("7. Exit\n");

        printf("Choose an option: ");
        scanf("%d", &option);

        switch (option)
        {
            case 1:
                createFile();
                break;

            case 2:
                displayFileTable();
                break;

            case 3:
                displayDisk();
                break;

            case 4:
                deleteFile();
                break;

            case 5:
                accessBlock();
                break;

            case 6:
                displayDiskInfo();
                break;

            case 7:
                printf("Exiting program.\n");
                break;

            default:
                printf("\nInvalid option selected!\n");
        }

        if (option >= 1 && option <= 6)
        {
            printf("\nDo you want to continue? (y/n): ");
            scanf(" %c", &choice);
        }
        else if (option == 7)
        {
            choice = 'n';
        }
        else
        {
            choice = 'y';
        }

    } while (choice == 'y' || choice == 'Y');

    return 0;
}

