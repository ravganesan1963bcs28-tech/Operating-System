
#include <stdio.h>
#include <stdlib.h>
#include <sys/types.h>
#include <sys/ipc.h>
#include <sys/shm.h>
#include <unistd.h>
#include <sys/wait.h>

int main()
{
   int in, out, num, i, *buff, si;
   int size = 10;
   in = 0;
   out = 0;

   // Allocate size + 1 slots. The last slot (buff[size]) will be our status flag.
   si = shmget(4777, sizeof(int) * (size + 1), IPC_CREAT | 0600);
   if (si == -1)
   {
      perror("Shmget");
      exit(1);
   }

   buff = (int *) shmat(si, NULL, 0);
   if (buff == (int *)-1)
   {
      perror("shmat");
      exit(1);
   }

   // Initialize the synchronization flag to 0 (Not Ready)
   buff[size] = 0;

   pid_t pid = fork();
   if (pid < 0)
   {
      perror("Fork");
      exit(1);
   }
   else if (pid > 0)
   {
      // --- PARENT PROCESS ---
      for (i = 0; i < size; i++)
      {
         printf("Enter data: ");
         if (scanf("%d", &num) != 1) return 1;
         buff[in % size] = num;
         in++;
      }
      
      // Inform the child that all data is ready
      buff[size] = 1; 

      shmdt(buff);
      wait(NULL); // Wait for child to finish reading
      shmctl(si, IPC_RMID, NULL); // Delete segment
   }
   else
   {
      // --- CHILD PROCESS ---
      // Loop continuously until the parent updates the flag to 1
      while (buff[size] == 0) {
         usleep(100000); // Sleep for 100ms to avoid burning CPU cycles
      }

      printf("\n--- Child Process Reading Data ---\n");
      for (i = 0; i < size; i++)
      {
         num = buff[out % size];
         out++;
         printf("Data[%d]: %d\n", out, num);
      }
      shmdt(buff);
   }
   return 0;
}


