#include <stdio.h>
#include <stdlib.h>
#include <sys/types.h>
#include <sys/ipc.h>
#include <sys/shm.h>
#include <unistd.h>

#define SIZE 10
#define SHM_KEY 54321 

int main() {
    int shmid;
    volatile int *buf;
    int num;

    shmid = shmget(SHM_KEY, sizeof(int) * (SIZE + 2), 0666);
    if (shmid == -1) {
        perror("Error: shmget failed. Run producer first");
        exit(1);
    }

    buf = (volatile int *)shmat(shmid, NULL, 0);
    if (buf == (void *)-1) {
        perror("Error: shmat failed");
        exit(1);
    }

    printf("Consumer started. Waiting for data...\n");

    while (1) {
        while (buf[SIZE] == buf[SIZE+1]) {
            usleep(50000); 
        }

        num = buf[buf[SIZE+1] % SIZE];
        buf[SIZE+1]++; 

        if (num == -1) {
            printf("Received exit signal (-1). Closing...\n");
            fflush(stdout); 
            break;
        }

        printf("Consumed: %d\n", num);
        fflush(stdout);
    }

    shmdt((void *)buf);
    usleep(50000); 
    shmctl(shmid, IPC_RMID, NULL); 
    
    printf("Consumer stopped.\n");
    return 0;
}

