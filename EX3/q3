#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/ipc.h>
#include <sys/shm.h>
#include <sys/wait.h>

#define SIZE 10

struct shared {
    int buffer[SIZE];
    int in;
    int out;
    volatile int count; 
};

int main() {
    int shmid, i;
    volatile struct shared *shm; 

    shmid = shmget(IPC_PRIVATE, sizeof(struct shared), IPC_CREAT | 0666);

    if (shmid < 0) {
        printf("Shared memory creation failed\n");
        exit(1);
    }

    shm = (volatile struct shared *)shmat(shmid, NULL, 0);

    shm->in = 0;
    shm->out = 0;
    shm->count = 0;

    pid_t pid = fork();

    if (pid == 0) { 
        int input[SIZE];
        
        for (i = 0; i < SIZE; i++) {
            printf("Enter data: ");
            scanf("%d", &input[i]);
        }

        printf("\nProducer Process:\n");

        for (i = 0; i < SIZE; i++) {
            if (shm->count == SIZE) {
                printf("Buffer Full\n");
                break;
            }

            shm->buffer[shm->in] = input[i];
            printf("Produced %d at slot %d\n", input[i], shm->in);

            shm->in = (shm->in + 1) % SIZE;
            shm->count++;
        }

        shmdt((void *)shm);
        exit(0);
    }
    else { 
        wait(NULL); 
        
        printf("\nConsumer Process:\n");

        while (shm->count > 0) {
            printf("Consumed %d from slot %d\n", shm->buffer[shm->out], shm->out);

            shm->out = (shm->out + 1) % SIZE;
            shm->count--;
        }

        shmdt((void *)shm);
        shmctl(shmid, IPC_RMID, NULL); 
    }

    return 0;
}

